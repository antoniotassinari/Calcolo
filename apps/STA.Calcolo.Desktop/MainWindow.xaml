<Window x:Class="STA.Calcolo.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TA-Calcolo" Width="1240" Height="850" MinWidth="850" MinHeight="600" Background="#F3F6F6" Foreground="#192845">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Tassinari.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
<DockPanel Margin="32" Background="#F3F6F6"><Grid DockPanel.Dock="Top" Margin="0,0,0,26"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="TA-Calcolo" FontSize="36" FontWeight="SemiBold"/><TextBlock Text="Strumenti di calcolo e progettazione" FontSize="17" Foreground="#526778" Margin="0,8,0,0"/></StackPanel><Image Grid.Column="1" Source="/STA.Calcolo.Desktop;component/Assets/Brand/Logo.png" Stretch="Uniform"/></Grid>
<StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0"><WrapPanel><TextBlock Text="{Binding Updates.VersionText}" VerticalAlignment="Center" Margin="0,0,16,6"/><Button Content="Verifica aggiornamenti" Command="{Binding Updates.CheckCommand}"/><TextBlock Text="{Binding Updates.Status}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="660"/></WrapPanel><TextBlock Text="Tassinari Associati · Ogni modulo conserva il progetto durante la sessione. Salva per conservarlo alla chiusura." Foreground="#526778" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
<ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Modules}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding OpenCommand}" Width="350" Height="155" Margin="0,0,16,16" Padding="0" Background="White" BorderBrush="#D6E0E2" Foreground="#192845" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#135F6E"/><StackPanel Grid.Column="1" Margin="20"><TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#526778" FontWeight="Normal"/></StackPanel></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
</DockPanel></Window>
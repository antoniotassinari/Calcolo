<Window x:Class="STA.Calcolo.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="STA · Calcolo" Width="1180" Height="820" MinWidth="750" MinHeight="550" Background="#F3F5F7">
 <DockPanel Margin="30" Background="#F3F5F7">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24"><TextBlock Text="STUDIO TASSINARI" Foreground="#52667B" FontSize="13"/><TextBlock Text="Calcolo" FontSize="36" FontWeight="SemiBold" Margin="0,8"/><TextBlock Text="Scegli un modulo. Ogni finestra mantiene il proprio progetto durante la sessione." FontSize="16"/></StackPanel>
  <StackPanel DockPanel.Dock="Bottom"><WrapPanel Margin="0,10"><TextBlock Text="{Binding Updates.VersionText}" VerticalAlignment="Center" Margin="0,0,15,0"/><Button Content="Verifica aggiornamenti" Command="{Binding Updates.CheckCommand}" Padding="10,5"/><TextBlock Text="{Binding Updates.Status}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="650"/></WrapPanel><TextBlock Text=".NET 10 · WPF · MVVM | Le formule storiche mantengono i limiti indicati nelle rispettive finestre." Foreground="#52667B" Margin="0,18,0,0" TextWrapping="Wrap"/></StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Modules}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
   <Button Command="{Binding OpenCommand}" Width="340" Height="160" Margin="0,0,15,15" Padding="18" Background="White" BorderBrush="#D7DFE7" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#42566B"/></StackPanel></Button>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
 </DockPanel>
</Window>

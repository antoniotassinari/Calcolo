<UserControl x:Class="STA.Calcolo.Desktop.Views.MasonryResultsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Language="it-IT"><StackPanel><TextBlock Text="Risultati del confronto" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="Confronto dei totali, seguito dai risultati di ogni maschio. Il contributo del telaio usa la resistenza effettivamente mobilitata." TextWrapping="Wrap" Margin="0,0,0,12"/><DataGrid ItemsSource="{Binding Comparison}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="None"><DataGrid.Columns><DataGridTextColumn Header="Grandezza" Binding="{Binding Grandezza}" Width="*"/><DataGridTextColumn Header="Unità" Binding="{Binding Unita}" Width="70"/><DataGridTextColumn Header="Prima" Binding="{Binding Prima,StringFormat=N2}" Width="135"/><DataGridTextColumn Header="Dopo muratura" Binding="{Binding Dopo,StringFormat=N2}" Width="135"/><DataGridTextColumn Header="Telaio" Binding="{Binding Telaio,StringFormat=N2}" Width="135"/><DataGridTextColumn Header="Finale" Binding="{Binding Finale,StringFormat=N2}" Width="135"/><DataGridTextColumn Header="Δ %" Binding="{Binding Variazione,StringFormat=N2}" Width="85"/></DataGrid.Columns></DataGrid><Expander Header="Percorso di calcolo · formule e sostituzioni numeriche" IsExpanded="True" Margin="0,18,0,10"><ItemsControl ItemsSource="{Binding Derivation}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F3F6F6" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16"/><Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Left,StringFormat='{}{0} ='}" VerticalAlignment="Center" FontFamily="Cambria Math" FontSize="19"/><StackPanel Grid.Column="1" HorizontalAlignment="Left"><TextBlock Text="{Binding Numerator}" TextWrapping="Wrap" FontFamily="Cambria Math" FontSize="19"/><Border BorderBrush="#192845" BorderThickness="0,1,0,0" Margin="0,5,0,0"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Denominator}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Denominator}" TextWrapping="Wrap" FontFamily="Cambria Math" FontSize="19" Margin="0,5,0,0"/></Border></StackPanel></Grid><TextBlock Text="{Binding Explanation}" TextWrapping="Wrap"/><TextBlock Text="{Binding Substitution}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander><TextBlock Text="Prima dell’intervento" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,10"/><DataGrid ItemsSource="{Binding BeforeResults}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="None" MaxHeight="400"><DataGrid.Columns><DataGridTextColumn Header="Maschio" Binding="{Binding Maschio}" Width="75"/><DataGridTextColumn Header="N [kN]" Binding="{Binding N,StringFormat=N2}" Width="*"/><DataGridTextColumn Header="σ [N/cm²]" Binding="{Binding Sigma,StringFormat=N2}" Width="*"/><DataGridTextColumn Header="K [N/cm]" Binding="{Binding K,StringFormat=N2}" Width="1.5*"/><DataGridTextColumn Header="Vt [kN]" Binding="{Binding Vt,StringFormat=N2}" Width="*"/><DataGridTextColumn Header="dy [mm]" Binding="{Binding Dy,StringFormat=N2}" Width="*"/><DataGridTextColumn Header="du [mm]" Binding="{Binding Du,StringFormat=N2}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Text="Dopo l’intervento" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,10"/><DataGrid ItemsSource="{Binding AfterResults}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="None" MaxHeight="400"><DataGrid.Columns><DataGridTextColumn Header="Maschio" Binding="{Binding Maschio}" Width="75"/><DataGridTextColumn Header="N [kN]" Binding="{Binding N,StringFormat=N2}" Width="*"/><DataGridTextColumn Header="σ [N/cm²]" Binding="{Binding Sigma,StringFormat=N2}" Width="*"/><DataGridTextColumn Header="K [N/cm]" Binding="{Binding K,StringFormat=N2}" Width="1.5*"/><DataGridTextColumn Header="Vt [kN]" Binding="{Binding Vt,StringFormat=N2}" Width="*"/><DataGridTextColumn Header="dy [mm]" Binding="{Binding Dy,StringFormat=N2}" Width="*"/><DataGridTextColumn Header="du [mm]" Binding="{Binding Du,StringFormat=N2}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Text="K: rigidezza laterale · Vt: resistenza a taglio · dy: spostamento al raggiungimento di Vt · du: spostamento ultimo del modello. Le relazioni Word e PDF includono anche dati, materiali, coefficienti, cerchiatura e limiti del calcolo." TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel></UserControl>
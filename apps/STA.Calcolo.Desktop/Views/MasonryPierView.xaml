<UserControl x:Class="STA.Calcolo.Desktop.Views.MasonryPierView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:STA.Calcolo.Desktop.Views"><UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/MasonryEditors.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources><Border BorderBrush="#D6E0E2" BorderThickness="1" CornerRadius="3" Background="#FCFEFE" Padding="12" Margin="0,0,10,10"><StackPanel>
<TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,14"/><CheckBox Content="Sezione fessurata: E e G × 0,5" IsChecked="{Binding Material.Cracked}" FontSize="11"/>
<TextBlock Text="GEOMETRIA" Style="{StaticResource SectionLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ContentControl Content="{Binding Editor.ByKey[H]}" ContentTemplate="{StaticResource Field}" IsEnabled="{Binding HeightEditable}"/><ContentControl Grid.Column="1" Content="{Binding Editor.ByKey[L]}" ContentTemplate="{StaticResource Field}" /></Grid><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><ContentControl Content="{Binding Editor.ByKey[T]}" ContentTemplate="{StaticResource Field}" /><ContentControl Grid.Column="1"/></Grid>
<TextBlock Text="{Binding GeometryText}" Background="#F0F4F4" Padding="6" FontSize="11"/>
<views:MasonryMaterialView DataContext="{Binding Material}"/><TextBlock Text="CARICO SUL MASCHIO" Style="{StaticResource SectionLabel}"/><ContentControl Content="{Binding Editor.ByKey[LoadMode]}" ContentTemplate="{StaticResource Field}" />
<ContentControl Content="{Binding Editor.ByKey[N]}" ContentTemplate="{StaticResource Field}"><ContentControl.Style><Style TargetType="ContentControl"><Style.Triggers><DataTrigger Binding="{Binding LinearLoad}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
<ContentControl Content="{Binding Editor.ByKey[Q]}" ContentTemplate="{StaticResource Field}" Visibility="{Binding LinearLoad,Converter={StaticResource Visible}}"/>
<TextBlock Text="Peso proprio non aggiunto. Compressione positiva. Resistenze prima di FC; E/G non fessurati." FontSize="10" TextWrapping="Wrap"/>
</StackPanel></Border></UserControl>
<Window x:Class="STA.Calcolo.Desktop.Views.WorkspaceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:STA.Calcolo.Desktop.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding Title}" Width="1080" Height="760" MinWidth="800" MinHeight="550" Background="#F3F5F7">
 <Window.Resources><BooleanToVisibilityConverter x:Key="Visible"/><Style TargetType="Button"><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Padding" Value="14,8"/></Style></Window.Resources>
 <DockPanel Margin="24" Background="#F3F5F7">
  <StackPanel DockPanel.Dock="Top"><TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,10,0,18"/>
   <WrapPanel Margin="0,0,0,18"><Button Content="Apri progetto" Command="{Binding OpenCommand}"/><Button Content="Salva progetto" Command="{Binding SaveCommand}"/><Button Content="Calcola" Command="{Binding CalculateCommand}"/><Button Content="Esporta risultati" Command="{Binding ExportCommand}"/></WrapPanel>
  </StackPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Label}" Margin="0,0,0,5"/>
     <Grid><TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Padding="7"><TextBox.Style><Style TargetType="TextBox"><Style.Triggers><DataTrigger Binding="{Binding HasChoices}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
      <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Padding="7" Visibility="{Binding HasChoices, Converter={StaticResource Visible}}"/>
     </Grid></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <StackPanel Visibility="{Binding HasData, Converter={StaticResource Visible}}"><TextBlock Text="{Binding DataHint}" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBox Text="{Binding Data, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" Height="220" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/><Button Content="Importa righe da file" Command="{Binding ImportDataCommand}" Margin="0,8,0,0"/></StackPanel>
   </StackPanel></ScrollViewer>
   <DockPanel Grid.Column="2"><StackPanel DockPanel.Dock="Top" Visibility="{Binding HasPlot, Converter={StaticResource Visible}}"><TextBlock Text="{Binding PlotCaption}" Margin="0,0,0,8"/><local:PlotView Series="{Binding Series}" EqualAxes="{Binding EqualAxes}" Height="260" Margin="0,0,0,12"/></StackPanel><DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Grandezza" Binding="{Binding Grandezza}" Width="*" MinWidth="210"/><DataGridTextColumn Header="Valore" Binding="{Binding Valore, StringFormat=0.######}" Width="130"/><DataGridTextColumn Header="Unità" Binding="{Binding Unità}" Width="90"/></DataGrid.Columns></DataGrid></DockPanel>
  </Grid>
 </DockPanel>
</Window>

<Window x:Class="STA.Calcolo.Desktop.Views.BeamWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Travi prefabbricate" Width="1100" Height="720" MinWidth="800" MinHeight="550" Background="#F3F5F7">
 <Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,4,8,4"/></Style></Window.Resources>
 <DockPanel Margin="24" Background="#F3F5F7"><StackPanel DockPanel.Dock="Top"><TextBlock Text="Travi prefabbricate" FontSize="28"/><TextBlock Text="Organizza sezioni e trefolature in un progetto comune. Il progetto originale non contiene un solutore completo per la verifica della trave." TextWrapping="Wrap" Margin="0,10"/><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="7"/><WrapPanel Margin="0,8,0,12"><Button Content="Apri progetto" Command="{Binding OpenCommand}"/><Button Content="Salva progetto" Command="{Binding SaveCommand}"/><Button Content="Controlla dati" Command="{Binding CheckCommand}"/></WrapPanel></StackPanel>
 <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,14,0,0"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <GroupBox Header="Sezioni"><DockPanel Margin="8"><WrapPanel DockPanel.Dock="Top"><Button Content="Editor sezioni" Command="{Binding OpenSectionCommand}"/><Button Content="Importa" Command="{Binding ImportSectionCommand}"/><Button Content="Rimuovi" Command="{Binding RemoveSectionCommand}"/></WrapPanel><ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Fields[nome]}" FontWeight="SemiBold"/><TextBlock Text="{Binding Data}" FontFamily="Consolas"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></GroupBox>
 <GroupBox Grid.Column="2" Header="Trefolature"><DockPanel Margin="8"><WrapPanel DockPanel.Dock="Top"><Button Content="Editor trefoli" Command="{Binding OpenTendonCommand}"/><Button Content="Importa" Command="{Binding ImportTendonCommand}"/><Button Content="Rimuovi" Command="{Binding RemoveTendonCommand}"/></WrapPanel><ListBox ItemsSource="{Binding Tendons}" SelectedItem="{Binding SelectedTendon}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Fields[tiro], StringFormat='Tensione iniziale: {0} daN/cm²'}" FontWeight="SemiBold"/><TextBlock Text="{Binding Data}" FontFamily="Consolas"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></GroupBox>
 </Grid></DockPanel>
</Window>
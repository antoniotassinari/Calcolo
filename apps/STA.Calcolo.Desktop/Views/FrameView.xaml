<UserControl x:Class="STA.Calcolo.Desktop.Views.FrameView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:STA.Calcolo.Desktop.Views"><UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/MasonryEditors.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources><StackPanel><TextBlock Text="{Binding Label}" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/><CheckBox Content="Includi il contributo della cerchiatura nel confronto finale e nella stampa" IsChecked="{Binding Enabled}" Margin="0,0,0,12"/><StackPanel Visibility="{Binding Enabled,Converter={StaticResource Visible}}">
<TextBlock Text="GEOMETRIA DEL TELAIO" Style="{StaticResource SectionLabel}"/><WrapPanel><ContentControl Width="230" Content="{Binding ByKey[H]}" ContentTemplate="{StaticResource Field}"/><ContentControl Width="230" Content="{Binding ByKey[NColumns]}" ContentTemplate="{StaticResource Field}"/><ContentControl Width="230" Content="{Binding ByKey[NProfiles]}" ContentTemplate="{StaticResource Field}"/></WrapPanel><views:SteelProfileView DataContext="{Binding Profile}"/><TextBlock Text="ACCIAIO E SCHEMA STATICO" Style="{StaticResource SectionLabel}"/><WrapPanel><ContentControl Width="230" Content="{Binding ByKey[E]}" ContentTemplate="{StaticResource Field}"/><ContentControl Width="230" Content="{Binding ByKey[Fy]}" ContentTemplate="{StaticResource Field}"/><ContentControl Width="230" Content="{Binding ByKey[Gamma]}" ContentTemplate="{StaticResource Field}"/><ContentControl Width="230" Content="{Binding ByKey[Portal]}" ContentTemplate="{StaticResource Field}"/></WrapPanel>
<WrapPanel><Button Content="Progetta profilo HEA / HEB / IPE" Command="{Binding DesignCommand}"/><Button Content="Usa proposta selezionata" Command="{Binding UseProfileCommand}"/></WrapPanel><TextBlock Text="Prima taglia per questa cerchiatura, mantenendo le altre attive: ΔK complessivo entro ±15% e resistenza finale maggiore dello stato prima. Profilo vuoto: nessuna soluzione." TextWrapping="Wrap" Margin="0,4,0,12"/>
<DataGrid ItemsSource="{Binding Proposals}" SelectedItem="{Binding SelectedProposal}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Famiglia" Binding="{Binding Family}" Width="*"/><DataGridTextColumn Header="Profilo proposto" Binding="{Binding Candidate.Profile.Id}" Width="*"/><DataGridTextColumn Header="ΔK %" Binding="{Binding Candidate.DK,StringFormat=N2}" Width="*"/><DataGridTextColumn Header="ΔV %" Binding="{Binding Candidate.DV,StringFormat=N2}" Width="*"/><DataGridTextColumn Header="Taglie compatibili" Binding="{Binding ValidCount}" Width="*"/></DataGrid.Columns></DataGrid>
<Expander Header="Ipotesi del modello e catalogo profili" Margin="0,14,0,0"><TextBlock Text="Sole colonne, asse forte. Esclusi traverso, nodi, ancoraggi, instabilità, interazione N-M, taglio e classe del profilo. Il portale modifica solo K; V resta invariato come nel foglio. OPPO: 66 profili, copia del 06/11/2026, dati indicativi." TextWrapping="Wrap" Margin="0,10"/></Expander>
</StackPanel></StackPanel></UserControl>
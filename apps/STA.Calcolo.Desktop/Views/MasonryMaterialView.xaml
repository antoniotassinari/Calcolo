<UserControl x:Class="STA.Calcolo.Desktop.Views.MasonryMaterialView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:STA.Calcolo.Desktop.Views"><UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/MasonryEditors.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources><StackPanel><TextBlock Text="CARATTERISTICHE DELLA MURATURA" Style="{StaticResource SectionLabel}"/>
<TextBlock Text="Tipologia" FontSize="11" Foreground="#526778" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Materials}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding MaterialId}" Margin="0,0,8,8"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,8"><TextBlock Text="Livello di conoscenza" FontSize="11" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,8,8"><TextBlock Text="Fattore di confidenza" FontSize="11" Margin="0,0,0,4"/><TextBox Text="{Binding ConfidenceText,Mode=OneWay}" IsReadOnly="True" Background="#EAF0F1"/></StackPanel></Grid>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<ContentControl Content="{Binding Editor.ByKey[FmBase]}" ContentTemplate="{StaticResource Field}"/>
<StackPanel Grid.Column="1" Margin="0,0,8,8"><TextBlock Text="fm di prog. [N/cm²]" FontSize="11" Foreground="#526778" Margin="0,0,0,4"/><TextBox Text="{Binding FmDesignText,Mode=OneWay}" IsReadOnly="True" Background="#EAF0F1"/></StackPanel></Grid>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<ContentControl Content="{Binding Editor.ByKey[TauBase]}" ContentTemplate="{StaticResource Field}"/>
<StackPanel Grid.Column="1" Margin="0,0,8,8"><TextBlock Text="τ di prog. [N/cm²]" FontSize="11" Foreground="#526778" Margin="0,0,0,4"/><TextBox Text="{Binding TauDesignText,Mode=OneWay}" IsReadOnly="True" Background="#EAF0F1"/></StackPanel></Grid>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<ContentControl Content="{Binding Editor.ByKey[E]}" ContentTemplate="{StaticResource Field}"/>
<StackPanel Grid.Column="1" Margin="0,0,8,8"><TextBlock Text="E di prog. [MPa]" FontSize="11" Foreground="#526778" Margin="0,0,0,4"/><TextBox Text="{Binding EDesignText,Mode=OneWay}" IsReadOnly="True" Background="#EAF0F1"/></StackPanel></Grid>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<ContentControl Content="{Binding Editor.ByKey[G]}" ContentTemplate="{StaticResource Field}"/>
<StackPanel Grid.Column="1" Margin="0,0,8,8"><TextBlock Text="G di prog. [MPa]" FontSize="11" Foreground="#526778" Margin="0,0,0,4"/><TextBox Text="{Binding GDesignText,Mode=OneWay}" IsReadOnly="True" Background="#EAF0F1"/></StackPanel></Grid>
<ContentControl Content="{Binding Editor.ByKey[Rho]}" ContentTemplate="{StaticResource Field}"/>
<TextBlock Text="{Binding MaterialNote}" TextWrapping="Wrap" FontSize="10" Margin="0,0,0,8"/>
<Expander Header="Coefficienti correttivi manuali" Foreground="#135F6E" FontSize="12" Margin="0,4"><ItemsControl ItemsSource="{Binding CoefficientFields}" ItemTemplate="{StaticResource Field}" Margin="0,8,0,0"/></Expander>
</StackPanel></UserControl>
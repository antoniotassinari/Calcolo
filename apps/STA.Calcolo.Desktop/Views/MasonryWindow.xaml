<Window x:Class="STA.Calcolo.Desktop.Views.MasonryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Muratura e cerchiatura" Width="1180" Height="820" MinWidth="880" MinHeight="620" Background="#F3F5F7">
<Window.Resources>
<BooleanToVisibilityConverter x:Key="Visible"/>
<Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,8"/></Style>
<DataTemplate x:Key="Fields"><ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="235" Margin="0,0,12,12"><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/><Grid>
<TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Padding="6"><TextBox.Style><Style TargetType="TextBox"><Style.Triggers><DataTrigger Binding="{Binding HasChoices}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox>
<ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Padding="6" Visibility="{Binding HasChoices, Converter={StaticResource Visible}}"/>
</Grid></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DataTemplate>
<DataTemplate x:Key="Pier"><Expander Header="{Binding Label}" IsExpanded="True" Background="White" Margin="0,0,0,12" Padding="12"><StackPanel>
<WrapPanel><ComboBox ItemsSource="{Binding Materials}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding MaterialId}" Width="360" Margin="0,0,8,8"/><ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" Width="80" Margin="0,0,8,8"/><Button Content="Applica materiale" Command="{Binding ApplyMaterialCommand}"/><Button Content="Rimuovi maschio" Command="{Binding RemoveCommand}"/></WrapPanel>
<TextBlock Text="{Binding MaterialNote}" TextWrapping="Wrap" Margin="0,0,0,8"/>
<ContentControl Content="{Binding Editor}" ContentTemplate="{StaticResource Fields}"/>
<TextBlock Text="Coefficienti separati da ;: malta buona; giunti sottili; ricorsi; connessione trasversale; nucleo scadente; iniezioni; intonaco armato" TextWrapping="Wrap"/>
<TextBox Text="{Binding Coefficients,UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,4,0,8"/>
<TextBlock Text="{Binding Note}" TextWrapping="Wrap"/>
</StackPanel></Expander></DataTemplate>
</Window.Resources>
<DockPanel Margin="24" Background="#F3F5F7">
<StackPanel DockPanel.Dock="Top"><TextBlock Text="Muratura e cerchiatura" FontSize="28" FontWeight="SemiBold"/><TextBox Text="{Binding Title,UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,12" Padding="7"/>
<WrapPanel><Button Content="Apri progetto" Command="{Binding OpenCommand}"/><Button Content="Salva progetto" Command="{Binding SaveCommand}"/><Button Content="Esempio Excel" Command="{Binding ExampleCommand}"/><Button Content="Copia prima → dopo" Command="{Binding CopyCommand}"/><Button Content="Calcola" Command="{Binding CalculateCommand}"/><Button Content="Esporta risultati" Command="{Binding ExportCommand}"/><Button Content="Relazione stampabile" Command="{Binding ReportCommand}"/></WrapPanel>
<TextBlock Text="Somma Vt come nel foglio Excel; altezza efficace = altezza geometrica. Confronto preliminare: non costituisce una verifica completa dell'intervento." TextWrapping="Wrap" Margin="0,0,0,12"/>
<WrapPanel><ComboBox ItemsSource="{Binding Materials}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding MaterialId}" Width="360" Margin="0,0,8,8"/><ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}" Width="80" Margin="0,0,8,8"/><Button Content="Applica materiale a tutti" Command="{Binding ApplyMaterialCommand}"/></WrapPanel>
</StackPanel>
<TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0" FontWeight="SemiBold"/>
<TabControl x:Name="ModuleTabs">
<TabItem Header="Prima"><DockPanel Margin="12"><WrapPanel DockPanel.Dock="Top"><Button Content="Aggiungi maschio (massimo 10)" Command="{Binding AddBeforeCommand}"/><Button Content="Uniforma altezze al primo" Command="{Binding EqualBeforeCommand}"/></WrapPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Before}" ItemTemplate="{StaticResource Pier}"/></ScrollViewer></DockPanel></TabItem><TabItem Header="Dopo"><DockPanel Margin="12"><WrapPanel DockPanel.Dock="Top"><Button Content="Aggiungi maschio (massimo 10)" Command="{Binding AddAfterCommand}"/><Button Content="Uniforma altezze al primo" Command="{Binding EqualAfterCommand}"/></WrapPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding After}" ItemTemplate="{StaticResource Pier}"/></ScrollViewer></DockPanel></TabItem><TabItem Header="Cerchiatura"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12"><ContentControl Content="{Binding Frame}" ContentTemplate="{StaticResource Fields}"/>
<TextBlock Text="Modello semplificato delle sole colonne, asse forte. Esclusi traverso, nodi, ancoraggi, instabilità, interazione N-M, taglio e classe del profilo. La luce del vano non entra nelle formule. Il portale modifica solo K; V resta invariato come nel foglio. Acciaio e spessore da confermare. OPPO: 66 profili, copia del 06/11/2026, dati indicativi." TextWrapping="Wrap" Margin="0,0,0,12"/>
<WrapPanel><Button Content="Progetta profilo HEA / HEB / IPE" Command="{Binding DesignCommand}"/><Button Content="Usa proposta selezionata" Command="{Binding UseProfileCommand}"/></WrapPanel>
<TextBlock Text="Prima taglia di ogni famiglia con ΔK entro ±15% e resistenza finale maggiore dello stato prima. Una cella profilo vuota indica nessuna soluzione." TextWrapping="Wrap" Margin="0,0,0,12"/>
<DataGrid ItemsSource="{Binding Proposals}" SelectedItem="{Binding SelectedProposal}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Famiglia" Binding="{Binding Family}"/><DataGridTextColumn Header="Profilo" Binding="{Binding Candidate.Profile.Id}"/><DataGridTextColumn Header="ΔK %" Binding="{Binding Candidate.DK,StringFormat=0.###}"/><DataGridTextColumn Header="ΔV %" Binding="{Binding Candidate.DV,StringFormat=0.###}"/><DataGridTextColumn Header="Taglie compatibili" Binding="{Binding ValidCount}"/><DataGridTextColumn Header="Esaminate" Binding="{Binding CheckedCount}"/></DataGrid.Columns></DataGrid>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Risultati"><DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="12"><DataGrid.Columns><DataGridTextColumn Header="Grandezza" Binding="{Binding Grandezza}" Width="*"/><DataGridTextColumn Header="Valore" Binding="{Binding Valore,StringFormat=0.######}" Width="160"/><DataGridTextColumn Header="Unità" Binding="{Binding Unità}" Width="100"/></DataGrid.Columns></DataGrid></TabItem>
</TabControl></DockPanel></Window>
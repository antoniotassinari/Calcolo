<Window x:Class="STA.Calcolo.Desktop.Views.MasonryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:STA.Calcolo.Desktop.Views" Title="TA-Calcolo · Confronto maschi murari" Language="it-IT" Width="1500" Height="950" MinWidth="920" MinHeight="640" FontFamily="/STA.Calcolo.Desktop;component/Assets/Brand/#Acherus Grotesque" FontSize="13" Foreground="#192845" Background="#F3F6F6">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/MasonryEditors.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Visible"/>

<DataTemplate x:Key="Pier"><views:MasonryPierView/></DataTemplate>
</ResourceDictionary></Window.Resources>
<DockPanel Margin="24" Background="#F3F6F6">
<StackPanel DockPanel.Dock="Top"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Confronto maschi murari" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="TA-Calcolo · Geometria, materiali e carichi. Da 1 a 10 maschi per stato." Foreground="#526778" Margin="0,4,0,10"/></StackPanel><Image Grid.Column="1" Source="/STA.Calcolo.Desktop;component/Assets/Brand/Logo.png" Stretch="Uniform" Margin="12,0,0,12"/></Grid>
<WrapPanel><Button Content="Carica esempio Excel" Command="{Binding ExampleCommand}"/><Button Content="Copia prima → dopo" Command="{Binding CopyCommand}"/><Button Content="Salva progetto" Command="{Binding SaveCommand}"/><Button Content="Apri progetto" Command="{Binding OpenCommand}"/><Button Content="Calcola dettagli" Command="{Binding CalculateCommand}"/><Button Content="Relazione Word" Command="{Binding WordReportCommand}"/><Button Content="Relazione PDF" Command="{Binding ReportCommand}"/><Button Content="Esporta dati JSON" Command="{Binding ExportCommand}"/></WrapPanel>
<Grid Margin="0,4,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Panel}" Padding="12" Margin="0,0,6,0"><StackPanel><TextBlock Text="Rigidezza totale K" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary.StiffnessDelta}" FontSize="25" Margin="0,3"/><TextBlock Text="{Binding Summary.StiffnessValues}" Foreground="#526778" FontSize="11"/><TextBlock Text="{Binding Summary.StiffnessOutcome}" Foreground="#135F6E" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Panel}" Padding="12" Margin="6,0,0,0"><StackPanel><TextBlock Text="Resistenza a taglio ΣVt · Excel" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary.ResistanceDelta}" FontSize="25" Margin="0,3"/><TextBlock Text="{Binding Summary.ResistanceValues}" Foreground="#526778" FontSize="11"/><TextBlock Text="{Binding Summary.ResistanceOutcome}" Foreground="#135F6E" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border></Grid></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#526778" Margin="0,8,0,0"/>
<ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,0">
<Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Configurazione e carico superiore" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="Scegli la risultante N [kN] oppure il carico uniforme q [kN/m]. N = q × lunghezza del singolo maschio [m]. Peso proprio e combinazioni di carico non vengono sommati automaticamente." TextWrapping="Wrap" Margin="0,0,0,12"/>
<TextBlock Text="Nome del progetto" FontSize="11"/><TextBox Text="{Binding Title,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Tipologia per nuovi maschi" FontSize="11" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Materials}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding MaterialId}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Livello" FontSize="11" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}"/></StackPanel><Button Grid.Column="2" Content="Applica materiale a tutti" Command="{Binding ApplyMaterialCommand}" VerticalAlignment="Bottom" Margin="0"/></Grid>
<WrapPanel Margin="0,14,0,10"><StackPanel Width="200" Margin="0,0,12,0"><TextBlock Text="Maschi prima" FontSize="11"/><ComboBox ItemsSource="{Binding Counts}" SelectedItem="{Binding BeforeCount}" Margin="0,4,0,8"/><CheckBox Content="Altezza tutta uguale · Prima" IsChecked="{Binding EqualBefore}" FontSize="11"/></StackPanel><StackPanel Width="200"><TextBlock Text="Maschi dopo" FontSize="11"/><ComboBox ItemsSource="{Binding Counts}" SelectedItem="{Binding AfterCount}" Margin="0,4,0,8"/><CheckBox Content="Altezza tutta uguale · Dopo" IsChecked="{Binding EqualAfter}" FontSize="11"/></StackPanel></WrapPanel>
<TextBlock Text="La spunta applica l'altezza del primo maschio agli altri dello stesso stato. Disattivandola si mantengono le altezze correnti." FontSize="11" TextWrapping="Wrap"/><Border Background="#FFF5E5" BorderBrush="#BC8135" BorderThickness="3,0,0,0" Padding="12" Margin="0,12,0,0"><TextBlock Text="Altezza efficace = altezza geometrica. Confronto preliminare secondo il foglio Excel, non verifica completa dell'intervento." TextWrapping="Wrap"/></Border>
</StackPanel></Border><Border x:Name="BeforeSection" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="01 / Prima dell’intervento" Background="#192845" Foreground="White" FontSize="18" FontWeight="SemiBold" Padding="12"/><TextBlock Text="Quattro colonne; dal quinto maschio si va a capo. Su schermi stretti scorri orizzontalmente." FontSize="11" Foreground="#526778" Margin="0,10"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Before}" ItemTemplate="{StaticResource Pier}" Width="1520" HorizontalAlignment="Left"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer></StackPanel></Border><Border x:Name="AfterSection" Style="{StaticResource Panel}"><StackPanel><TextBlock Text="02 / Dopo l’intervento" Background="#135F6E" Foreground="White" FontSize="18" FontWeight="SemiBold" Padding="12"/><TextBlock Text="Quattro colonne; dal quinto maschio si va a capo. Su schermi stretti scorri orizzontalmente." FontSize="11" Foreground="#526778" Margin="0,10"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding After}" ItemTemplate="{StaticResource Pier}" Width="1520" HorizontalAlignment="Left"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer></StackPanel></Border><Border x:Name="FrameSection" Style="{StaticResource Panel}"><views:FrameView DataContext="{Binding Frame}"/></Border><Border x:Name="ResultsSection" Style="{StaticResource Panel}"><views:MasonryResultsView/></Border>
</StackPanel></ScrollViewer></DockPanel></Window>
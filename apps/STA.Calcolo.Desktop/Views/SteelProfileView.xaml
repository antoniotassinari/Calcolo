<UserControl x:Class="STA.Calcolo.Desktop.Views.SteelProfileView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:STA.Calcolo.Desktop.Views"><UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/MasonryEditors.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources><StackPanel Margin="0,10,0,16"><TextBlock Text="PROFILO DELLE COLONNE" Style="{StaticResource SectionLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="Profilo OPPO" FontSize="11" Margin="0,0,0,4"/><ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Id" SelectedValuePath="Id" SelectedValue="{Binding SelectedId}"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="Jx asse forte [cm⁴]" FontSize="11" Margin="0,0,0,4"/><TextBox Text="{Binding Model.Jx,Mode=OneWay,StringFormat=N2}" IsReadOnly="True" Background="#EAF0F1"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Wx elastico [cm³]" FontSize="11" Margin="0,0,0,4"/><TextBox Text="{Binding Model.Wx,Mode=OneWay,StringFormat=N2}" IsReadOnly="True" Background="#EAF0F1"/></StackPanel></Grid></StackPanel></UserControl>